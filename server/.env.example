PORT=4000
MONGODB_URI=mongodb://localhost:27017/gluten-free-app
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Orígenes permitidos por CORS, separados por coma. Obligatorio — el
# servidor no arranca si falta (sin default abierto a '*').
# Dev: http://localhost:5173
# Prod: PLACEHOLDER — actualizar con el dominio real de Netlify (u otro)
# antes de deployar. No dejar este valor de ejemplo en producción.
CORS_ORIGINS=http://localhost:5173,https://gluten-free-app.netlify.app

# Places API (New), con billing habilitado. Usada por
# scripts/fetchGooglePlaceIds.js y el endpoint GET /establishments/:id/photo.
# Restringila en Google Cloud Console a las APIs de Places que uses.
GOOGLE_PLACES_API_KEY=tu-api-key-de-places-api-new
